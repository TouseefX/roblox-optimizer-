<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed on Android 11+ so this app is allowed to see/launch Roblox -->
    <queries>
        <package android:name="com.roblox.client" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.OptimizerByTabi"
        android:supportsRtl="true">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.OptimizerByTabi.Fullscreen"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OptimizeActivity"
            android:exported="false"
            android:theme="@style/Theme.OptimizerByTabi.Fullscreen"
            android:screenOrientation="portrait" />

        <activity
            android:name=".LaunchActivity"
            android:exported="false"
            android:theme="@style/Theme.OptimizerByTabi.Fullscreen"
            android:screenOrientation="portrait" />

    </application>

</manifest>
